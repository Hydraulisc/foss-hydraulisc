<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hydraulisc</title>
    <meta property="og:title" content="Hydraulisc - Stay in the loop">
    <meta property="og:description" content="Stay in the loop, with Hydraulisc - where communities come together!">
    <meta property="og:image" content="https://about.hydraulisc.net/assets/img/Foss-H-logo.png">
    <!-- Unused Canonical and alternate "link"'s removed: https://www.html-easy.com/references/html-link-tag/ & https://ahrefs.com/blog/canonical-tags/ -->
    <link rel="icon" type="image/png" href="https://about.hydraulisc.net/assets/img/Foss-H-logo.png">
    <meta name="description" content="Stay in the loop, with Hydraulisc - where communities come together!">
    <meta property="og:site_name" content="Hydraulisc - Stay in the loop">
    <meta name="theme-color" content="rgba(33, 33, 33, 0.98)">
    <link rel="stylesheet" href="/css/globalStyles.css">
    <link rel="stylesheet" href="/css/defaultStyle.css">
    <link rel="stylesheet" href="/css/popupStyles.css">
    <script src="/js/themeHelper.js"></script>
</head>
<body>
    <%- include('../partials/header', { username: ownId }) %>
        <div class="app-container">
            <div class="gridz">
                <div class="home_container">
                    <h3>Latest Uploads</h3>
                    <div class="container_container">
                        <main class="landing_feat">
                            <div style="margin-bottom: 4rem;">
                                <% if (posts.length) { %>
                                    <% for (const post of posts) { %>
                                        <div id="<%- post.id %>" class="draulisc_post_container">
                                            <div style="margin-bottom: 12px;">
                                                <span class="draulisc_post_header_container">
                                                    <span class="draulisc_post_header">
                                                        <span class="draulisc_post_user_container">
                                                            <span style="display: flex;">
                                                                <div>
                                                                    <div>
                                                                        <a href="/user/<%- post.user_id %>"
                                                                            class="draulisc_post_user">
                                                                            <div style="padding-right: 6px;">
                                                                                <img src="<%- post.pfp %>"
                                                                                    style="color: black; border-radius: 50%; overflow: hidden; justify-content: center; align-items: center; width: 40px; height: 40px; display: flex;"
                                                                                    loading="lazy">
                                                                            </div>
                                                                            <span
                                                                                style="font-size: larger; padding-right: 6px;"><%-
                                                                                    post.username %></span>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </span>
                                                        </span>
                                                    </span>
                                                    <div class="dropdown">
                                                        <span class="popup_menu <%- post.id %> dropbtn">⋮</span>
                                                        <div class="dropdown-content">
                                                            <a style="text-transform: uppercase; text-align: center; font-weight: 600; font-size: small;"
                                                                href="https://about.hydraulisc.net/help/articles/101013/"
                                                                target="_blank">Report Content</a>
                                                            <% if(post.user_id==ownId) { %>
                                                                <a style="text-transform: uppercase; text-align: center; font-weight: 600; font-size: small;"
                                                                    href="/post/<%- post.id %>/edit">Edit</a>
                                                                <form action="/api/posts/<%- post.id %>/delete"
                                                                    method="post">
                                                                    <button class="destructive_options"
                                                                        type="submit">Delete</button>
                                                                </form>
                                                                <% } %>
                                                                <% if(isAdmin) { %>
                                                                    <form action="/auth/admin/<%- post.id %>/sudodelete" method="post">
                                                                        <button class="destructive_options" type="submit">Sudo Delete</button>
                                                                    </form>
                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </span>
                                            </div>
                                            <a style="inset: 0; text-decoration: none; color: #d7d9e0;"
                                                href="/post/<%- post.id %>">
                                                <div style="display: flex; margin-top: .3rem;">
                                                    <div
                                                        style="overflow: hidden; margin-left: auto; margin-right: auto; position: relative; display: inline-block;">
                                                        <div class="overlay"></div>
                                                        <img class="draulisc_post_body"
                                                            src="/uploads/<%- post.filename %>" loading="lazy">
                                                    </div>
                                                </div>
                                                <div style="display: flex; margin-top: .3rem; margin-bottom: .3rem;">
                                                    <% if (post.title) { %> <!-- Check if post.title exists -->
                                                        <div class="draulisc_post_texter" style="overflow: hidden;">
                                                            <%- post.title %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                                <% if (ownId) { %>
                                                    <div class="political-bias" style="position: relative; overflow: hidden;"
                                                        id="fancy-icons">
                                                        <div id="love-count"
                                                            style="float: left; display: block; text-align: center; padding: 14px; text-decoration: none; cursor: pointer;">
                                                            <svg width="26px" height="26px" viewBox="0 0 24 24" fill="none">
                                                                <g stroke-width="0"></g>
                                                                <g stroke-linecap="round" stroke-linejoin="round"></g>
                                                                <g>
                                                                    <path d="M8.96173 18.9109L9.42605 18.3219L8.96173 18.9109ZM12 5.50063L11.4596 6.02073C11.601 6.16763 11.7961 6.25063 12 6.25063C12.2039 6.25063 12.399 6.16763 12.5404 6.02073L12 5.50063ZM15.0383 18.9109L15.5026 19.4999L15.0383 18.9109ZM7.00061 16.4209C6.68078 16.1577 6.20813 16.2036 5.94491 16.5234C5.68169 16.8432 5.72758 17.3159 6.04741 17.5791L7.00061 16.4209ZM2.34199 13.4115C2.54074 13.7749 2.99647 13.9084 3.35988 13.7096C3.7233 13.5108 3.85677 13.0551 3.65801 12.6917L2.34199 13.4115ZM2.75 9.1371C2.75 6.98623 3.96537 5.18252 5.62436 4.42419C7.23607 3.68748 9.40166 3.88258 11.4596 6.02073L12.5404 4.98053C10.0985 2.44352 7.26409 2.02539 5.00076 3.05996C2.78471 4.07292 1.25 6.42503 1.25 9.1371H2.75ZM8.49742 19.4999C9.00965 19.9037 9.55954 20.3343 10.1168 20.6599C10.6739 20.9854 11.3096 21.25 12 21.25V19.75C11.6904 19.75 11.3261 19.6293 10.8736 19.3648C10.4213 19.1005 9.95208 18.7366 9.42605 18.3219L8.49742 19.4999ZM15.5026 19.4999C16.9292 18.3752 18.7528 17.0866 20.1833 15.4758C21.6395 13.8361 22.75 11.8026 22.75 9.1371H21.25C21.25 11.3345 20.3508 13.0282 19.0617 14.4798C17.7469 15.9603 16.0896 17.1271 14.574 18.3219L15.5026 19.4999ZM22.75 9.1371C22.75 6.42503 21.2153 4.07292 18.9992 3.05996C16.7359 2.02539 13.9015 2.44352 11.4596 4.98053L12.5404 6.02073C14.5983 3.88258 16.7639 3.68748 18.3756 4.42419C20.0346 5.18252 21.25 6.98623 21.25 9.1371H22.75ZM14.574 18.3219C14.0479 18.7366 13.5787 19.1005 13.1264 19.3648C12.6739 19.6293 12.3096 19.75 12 19.75V21.25C12.6904 21.25 13.3261 20.9854 13.8832 20.6599C14.4405 20.3343 14.9903 19.9037 15.5026 19.4999L14.574 18.3219ZM9.42605 18.3219C8.63014 17.6945 7.82129 17.0963 7.00061 16.4209L6.04741 17.5791C6.87768 18.2624 7.75472 18.9144 8.49742 19.4999L9.42605 18.3219ZM3.65801 12.6917C3.0968 11.6656 2.75 10.5033 2.75 9.1371H1.25C1.25 10.7746 1.66995 12.1827 2.34199 13.4115L3.65801 12.6917Z" fill="var(--text-primary)"></path>
                                                                </g>
                                                            </svg> <%- post.like_count %>
                                                        </div>
                                                        <div style="float: left; display: block; text-align: center; padding: 14px; text-decoration: none; cursor: pointer;">
                                                            <svg width="26px" height="26px" viewBox="0 0 24 24" fill="none">
                                                                <g stroke-width="0"></g>
                                                                <g stroke-linecap="round" stroke-linejoin="round"></g>
                                                                <g transform="rotate(-40 12 12)">
                                                                    <path d="M9.91158 12H7.45579H4L2.02268 4.13539C2.0111 4.0893 2.00193 4.04246 2.00046 3.99497C1.97811 3.27397 2.77209 2.77366 3.46029 3.10388L22 12L3.46029 20.8961C2.77983 21.2226 1.99597 20.7372 2.00002 20.0293C2.00038 19.9658 2.01455 19.9032 2.03296 19.8425L3.5 15" stroke="var(--text-primary)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                </g>
                                                            </svg>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <div class="political-bias" style="position: relative; overflow: hidden;"
                                                        id="fancy-icons">
                                                        <div id="love-count"
                                                            style="float: left; display: block; text-align: center; padding: 14px; text-decoration: none; cursor: pointer;">
                                                            <svg width="26px" height="26px" viewBox="0 0 24 24" fill="none">
                                                                <g stroke-width="0"></g>
                                                                <g stroke-linecap="round" stroke-linejoin="round"></g>
                                                                <g>
                                                                    <path d="M8.96173 18.9109L9.42605 18.3219L8.96173 18.9109ZM12 5.50063L11.4596 6.02073C11.601 6.16763 11.7961 6.25063 12 6.25063C12.2039 6.25063 12.399 6.16763 12.5404 6.02073L12 5.50063ZM15.0383 18.9109L15.5026 19.4999L15.0383 18.9109ZM7.00061 16.4209C6.68078 16.1577 6.20813 16.2036 5.94491 16.5234C5.68169 16.8432 5.72758 17.3159 6.04741 17.5791L7.00061 16.4209ZM2.34199 13.4115C2.54074 13.7749 2.99647 13.9084 3.35988 13.7096C3.7233 13.5108 3.85677 13.0551 3.65801 12.6917L2.34199 13.4115ZM2.75 9.1371C2.75 6.98623 3.96537 5.18252 5.62436 4.42419C7.23607 3.68748 9.40166 3.88258 11.4596 6.02073L12.5404 4.98053C10.0985 2.44352 7.26409 2.02539 5.00076 3.05996C2.78471 4.07292 1.25 6.42503 1.25 9.1371H2.75ZM8.49742 19.4999C9.00965 19.9037 9.55954 20.3343 10.1168 20.6599C10.6739 20.9854 11.3096 21.25 12 21.25V19.75C11.6904 19.75 11.3261 19.6293 10.8736 19.3648C10.4213 19.1005 9.95208 18.7366 9.42605 18.3219L8.49742 19.4999ZM15.5026 19.4999C16.9292 18.3752 18.7528 17.0866 20.1833 15.4758C21.6395 13.8361 22.75 11.8026 22.75 9.1371H21.25C21.25 11.3345 20.3508 13.0282 19.0617 14.4798C17.7469 15.9603 16.0896 17.1271 14.574 18.3219L15.5026 19.4999ZM22.75 9.1371C22.75 6.42503 21.2153 4.07292 18.9992 3.05996C16.7359 2.02539 13.9015 2.44352 11.4596 4.98053L12.5404 6.02073C14.5983 3.88258 16.7639 3.68748 18.3756 4.42419C20.0346 5.18252 21.25 6.98623 21.25 9.1371H22.75ZM14.574 18.3219C14.0479 18.7366 13.5787 19.1005 13.1264 19.3648C12.6739 19.6293 12.3096 19.75 12 19.75V21.25C12.6904 21.25 13.3261 20.9854 13.8832 20.6599C14.4405 20.3343 14.9903 19.9037 15.5026 19.4999L14.574 18.3219ZM9.42605 18.3219C8.63014 17.6945 7.82129 17.0963 7.00061 16.4209L6.04741 17.5791C6.87768 18.2624 7.75472 18.9144 8.49742 19.4999L9.42605 18.3219ZM3.65801 12.6917C3.0968 11.6656 2.75 10.5033 2.75 9.1371H1.25C1.25 10.7746 1.66995 12.1827 2.34199 13.4115L3.65801 12.6917Z" fill="var(--text-primary)"></path>
                                                                </g>
                                                            </svg> <%- post.like_count %>
                                                        </div>
                                                        <div style="float: left; display: block; text-align: center; padding: 14px; text-decoration: none; cursor: pointer;">
                                                            <svg width="26px" height="26px" viewBox="0 0 24 24" fill="none">
                                                                <g stroke-width="0"></g>
                                                                <g stroke-linecap="round" stroke-linejoin="round"></g>
                                                                <g transform="rotate(-40 12 12)">
                                                                    <path d="M9.91158 12H7.45579H4L2.02268 4.13539C2.0111 4.0893 2.00193 4.04246 2.00046 3.99497C1.97811 3.27397 2.77209 2.77366 3.46029 3.10388L22 12L3.46029 20.8961C2.77983 21.2226 1.99597 20.7372 2.00002 20.0293C2.00038 19.9658 2.01455 19.9032 2.03296 19.8425L3.5 15" stroke="var(--text-primary)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                </g>
                                                            </svg>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </a>
                                        </div>
                                        <% } %>
                                            <% } else { %>
                                                <div id="" class="draulisc_post_container">
                                                    <div style="margin-bottom: 12px;">
                                                        <span class="draulisc_post_header_container">
                                                            <span class="draulisc_post_header">
                                                                <span class="draulisc_post_user_container">
                                                                    <span style="display: flex;">
                                                                        <div>
                                                                            <div>
                                                                                <a href="/" class="draulisc_post_title">
                                                                                    <div style="padding-right: 6px;">
                                                                                        <img src="/img/defaultpfp.png"
                                                                                            style="color: black; border-radius: 50%; overflow: hidden; justify-content: center; align-items: center; width: 40px; height: 40px; display: flex;"
                                                                                            loading="lazy">
                                                                                    </div>
                                                                                    <span style="font-size: larger;">No
                                                                                        Data</span>
                                                                                </a>
                                                                            </div>
                                                                        </div>
                                                                    </span>
                                                                </span>
                                                            </span>
                                                            <span></span>
                                                        </span>
                                                    </div>
                                                    <a style="inset: 0; text-decoration: none; color: white;" href="/">
                                                        <div style="display: flex; margin-top: .3rem;">
                                                            <div
                                                                style="overflow: hidden; margin-left: auto; margin-right: auto; position: relative; display: inline-block;">
                                                                <img class="draulisc_post_body"
                                                                    src="/img/defaultpfp.png" loading="lazy">
                                                                <div class="overlay"></div>
                                                            </div>
                                                        </div>
                                                        <div
                                                            style="display: flex; margin-top: .3rem; margin-bottom: .3rem;">
                                                            <div class="draulisc_post_texter" style="overflow: hidden;">
                                                                If you are seeing this post, no posts exist on this
                                                                instance, or this instance has it's feed set to private.
                                                                <a href="/login">Login</a> to view more. <a
                                                                    href="https://blog.hydraulisc.net/blog/haulisc-roadmap"
                                                                    target="_blank"
                                                                    rel="noopener noreferrer">Roadmap</a>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                                <% } %>
                            </div>
                        </main>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../partials/cookies', { cookies }) %>
            <%- include('../partials/footer', { username: ownId}) %>
</body>
</html>