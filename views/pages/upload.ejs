<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload | Hydraulisc</title>
    <meta property="og:title" content="Hydraulisc - Stay in the loop">
    <meta property="og:description" content="Stay in the loop, with Hydraulisc - where communities come together!">
    <meta property="og:image" content="https://about.hydraulisc.net/assets/img/Foss-H-logo.png">
    <!-- Unused Canonical and alternate "link"'s removed: https://www.html-easy.com/references/html-link-tag/ & https://ahrefs.com/blog/canonical-tags/ -->
    <link rel="icon" type="image/png" href="https://about.hydraulisc.net/assets/img/Foss-H-logo.png">
    <meta name="description" content="Stay in the loop, with Hydraulisc - where communities come together!">
    <meta property="og:site_name" content="Hydraulisc - Stay in the loop">
    <meta name="theme-color" content="rgba(33, 33, 33, 0.98)">
    <link rel="stylesheet" href="/css/globalStyles.css">
    <link rel="stylesheet" href="/css/uploadStyles.css">
    <script src="/js/themeHelper.js"></script>
</head>
<body>
    <%- include('../partials/header', { username: ownId }) %>

    <main class="upload_page">
        <h1 class="upload_heading">New post</h1>

        <form class="upload_form" action="/api/upload" method="post" enctype="multipart/form-data">

            <%# Picker + preview in one. The file input is stretched invisibly over the whole box, so
                tapping, clicking and drag-and-drop all work natively with no JS. The small script
                below only swaps in a live preview. %>
            <label class="dropzone" for="file">
                <input class="dropzone_input" type="file" name="file" id="file" required
                       accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp"
                       aria-describedby="file-hint">
                <span class="dropzone_ring" aria-hidden="true"></span>

                <img class="dropzone_preview" id="preview" alt="" hidden>

                <span class="dropzone_empty">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <rect x="3" y="3" width="18" height="18" rx="3"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                    </svg>
                    <span class="dropzone_cta">Choose a photo</span>
                    <span class="dropzone_sub dropzone_sub_touch">Tap to browse your library or camera</span>
                    <span class="dropzone_sub dropzone_sub_pointer">or drag and drop it here</span>
                </span>

                <%# Shown by CSS alone (no JS) once a file is chosen, until/unless the preview loads. %>
                <span class="dropzone_ready">
                    <span class="dropzone_cta">Photo selected</span>
                    <span class="dropzone_sub">Tap or click to change it</span>
                </span>

                <span class="dropzone_change" aria-hidden="true">Change photo</span>
                </label>
            <p class="hint" id="file-hint">JPEG, PNG, GIF or WebP, up to 25&nbsp;MB.</p>

            <div class="field">
                <label for="title">Caption <span class="optional">(optional)</span></label>
                <textarea id="title" name="title" rows="4" maxlength="2200" autocomplete="off" aria-describedby="title-hint"></textarea>
                <p class="hint" id="title-hint">
                    Up to 2,200 characters.
                </p>
            </div>

            <details class="format_help">
                <summary>Quick formatting reference</summary>
                <ul>
                    <li><code>&lt;b&gt;bold&lt;/b&gt;</code> <span aria-hidden="true">&rarr;</span><span class="visually_hidden">shows as</span> <b>bold</b></li>
                    <li><code>&lt;i&gt;italic&lt;/i&gt;</code> <span aria-hidden="true">&rarr;</span><span class="visually_hidden">shows as</span> <i>italic</i></li>
                    <li>Web addresses starting with <code>https://</code> or <code>www.</code> become links automatically.</li>
                    <li>Any other HTML is shown as plain text.</li>
                </ul>
            </details>

            <button class="submit" type="submit">Upload</button>
            <p class="hint"><a href="https://about.hydraulisc.net/help/articles/101004/" target="_blank" rel="noopener noreferrer">Uploading help<span class="visually_hidden"> (opens in a new tab)</span></a></p>
        </form>

        <noscript><p class="hint">Photo previews need JavaScript. Uploading still works without it.</p></noscript>
    </main>

    <script>
        // Progressive enhancement: live preview. The page works fine without this.
        (function () {
            var input = document.getElementById("file");
            var preview = document.getElementById("preview");
            var zone = input.closest(".dropzone");
            var objectUrl = null;

            function clearPreview() {
                if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
                preview.hidden = true;
                preview.removeAttribute("src");
                zone.classList.remove("has-preview");
            }

            input.addEventListener("change", function () {
                clearPreview();
                var file = input.files && input.files[0];
                if (!file || file.type.indexOf("image/") !== 0) return;
                objectUrl = URL.createObjectURL(file);
                preview.alt = "Preview of " + file.name;
                preview.src = objectUrl;
                preview.hidden = false;
                zone.classList.add("has-preview");
            });

            // If the browser can't decode it, fall back to the plain "Photo selected" state.
            preview.addEventListener("error", clearPreview);
        })();
    </script>

    <%- include('../partials/cookies', { cookies }) %>
    <%- include('../partials/footer', { username: ownId }) %>
</body>
</html>
