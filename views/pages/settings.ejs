<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings | Hydraulisc</title>
    <link rel="canonical" href="https://hydraulisc.net/404" />
    <link rel="icon" type="image/png" href="https://about.hydraulisc.net/assets/img/Foss-H-logo.png">
    <meta name="description" content="Stay in the loop, with Hydraulisc - where communities come together!">
    <meta property="og:site_name" content="Hydraulisc - Stay in the loop">
    <meta name="theme-color" content="rgba(33, 33, 33, 0.98)">
    <link rel="stylesheet" href="/css/globalStyles.css">
    <link rel="stylesheet" href="/css/settingsStyles.css">
    <script src="/js/settingsFunctionality.js" defer></script>
    <script src="/js/themeHelper.js"></script>
</head>
<body>
    <%- include('../partials/header', { username: ownId }) %>
    <div class="hydrauliscapp">
        <%- include('../partials/settingsNav', { isAdmin,  }) %>
        <main class="settings_content">
            <div class="return_btn">
                <a href="/user/<%- ownId %>">x</a>
            </div>
            <noscript>WARNING! Settings requires JS!</noscript>
            <section id="account" class="settings_section">
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Account Settings</h1>
                            <div class="lluviere" style="background-image: url(<%-banner%>);">
                                <button class="lluviere_one mobileHideMe" onclick="changePfpModal()">update avatar</button>
                                <button class="lluviere_two mobileHideMe" onclick="changePfpModal()">update banner</button>
                                <div class="avatarContainer">
                                    <span title="<%- username %>'s avatar">
                                        <img src="<%- pfp %>" alt="<%- username %>'s avatar" class="avatar">
                                    </span>
                                </div>
                            </div>
                            <div class="caption mobileHideMe">Max file size 10MB. Accepted File Types: 'image/jpeg', 'image/png', 'image/gif', 'image/webp'.</div>
                            <div class="avatarInput mobileRevealMe" style="display: none;">
                                <form method="post" action="/api/avatarUpdate" enctype="multipart/form-data">
                                    <div class="label">Update Avatar</div>
                                    <input type="file" name="avatar" id="avatar">
                                    <button class="button_save" type="submit">Save</button>
                                    <div class="caption">Max file size 10MB. Accepted File Types: 'image/jpeg', 'image/png', 'image/gif', 'image/webp'.</div>
                                </form>
                            </div>
                            <div class="bannerInput mobileRevealMe" style="display: none;">
                                <form method="post" action="/api/bannerUpdate" enctype="multipart/form-data">
                                    <div class="label">Update Banner</div>
                                    <input type="file" name="banner" id="banner">
                                    <button id="banner_edit" class="button_save" type="submit">Save</button>
                                    <div class="caption">Max file size 10MB. Accepted File Types: 'image/jpeg', 'image/png', 'image/gif', 'image/webp'.</div>
                                </form>
                            </div>
                            <div>
                                <label>
                                    <div>Username</div>
                                    <div class="input">
                                        <input type="text" name="displayName" id="displayName" placeholder="Username" value="<%- username %>" disabled style="color: var(--text-secondary) !important;">
                                    </div>
                                    <div class="caption">Usernames cannot be changed at the current moment in time. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Roadmap</a>.</div>
                                </label>
                            </div>
                            <div>
                                <!-- TO-DO: BIO -->
                                <form action="" method="post">
                                    <label>
                                        <div>Biography</div>
                                        <div class="input">
                                            <textarea name="biography" id="biography" spellcheck="false"></textarea>
                                        </div>
                                        <div class="caption">You can use up to 200 characters in you biography</div>
                                    </label>
                                    <button type="submit" class="button">Save</button>
                                </form>
                            </div>
                            <label>
                                <hr>
                                <input type="checkbox" disabled>
                                <span>
                                    <span>Mark this account as automated.</span>
                                    <p class="caption"><b>WARNING! EXPERIMENTAL!</b> Enable this option if this account is controlled by a program. If enabled, it will act as a flag for other developers to prevent endless interaction chains with other automated accounts and adjust Hydraulisc's internal systems to treat this account as an automated account.</p>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>
            <section id="privacy" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Privacy</h1>
                            <div class="_formRoot">
                                <label>
                                    <input type="checkbox" disabled>
                                    <span>
                                        <span>Followers Only</span>
                                        <p class="caption">This setting makes your posts invisible to others.</p>
                                    </span>
                                </label>
                                <label>
                                    <input type="checkbox" disabled>
                                    <span>
                                        <span>Indexable</span>
                                        <p class="caption">Allow your account and/or public posts to be recommended to others. If this is unchecked, you also won't receive recommendations.</p>
                                    </span>
                                </label>
                                <label>
                                    <input type="checkbox" disabled>
                                    <span>
                                        <span>Reject crawler indexing</span>
                                        <p class="caption">Ask external search engines to not index your content. Google, by default, ignores this request.</p>
                                    </span>
                                </label>
                                <label>
                                    <input type="checkbox" disabled>
                                    <span>
                                        <span>Prevent AI bot scraping</span>
                                        <p class="caption">Request third-party AI language models not to study content you upload, such as posts and images. Proven ineffective in 90% of cases.</p>
                                    </span>
                                </label>
                                <label>
                                    <input type="checkbox" disabled>
                                    <span>
                                        <span>Keep content warnings</span>
                                        <p class="caption">This will aggressively remind you to consent to cookies.</p>
                                    </span>
                                </label>
                                <label>
                                    <input type="checkbox" disabled>
                                    <span>
                                        <span>Add "re:" at the beginning of replies to comments</span>
                                        <p class="caption">Addes "re:" at the beginning of comment replies for you.</p>
                                    </span>
                                </label>
                                <button type="submit" class="button" disabled style="cursor: not-allowed;">Save</button>
                            </div>
                            <div class="_formRoot">
                                <form action="/api/datareq" method="post">
                                    <label>
                                        <span>
                                            <span>Personal Privacy Checkup Request</span>
                                            <p class="caption">Request your account data.</p>
                                        </span>
                                    </label>
                                    <button type="submit" class="button">Request Data</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section id="security" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Security</h1>
                            <h3>Password</h3>
                            <p class="caption">This section is under construction. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Roadmap</a>.</p>
                            <h3>MFA</h3>
                            <p class="caption">Add an extra layer of security by enabling 2FA on your account.</p>
                            <div class="_formRoot _formBlock">
                                <button class="danger">Add Authenticator</button>
                                <button class="danger">Register Pass Key</button>
                            </div>
                            <p class="caption">MFA is not currently supported. Please come back later. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Roadmap</a>.</p>
                        </div>
                    </div>
                </div>
            </section>
            <section id="language-icons" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Language & Icons</h1>
                            <h3>Interface Language</h3>
                            <form action="/api/languageUpdate" method="POST">
                                <select class="select">
                                    <option value="english">English</option>
                                    <option value="spanish">Español</option>
                                    <option value="catalan">Català</option>
                                </select>
                                <button type="submit">Save</button>
                            </form>
                            <p class="caption">Hydraulisc is undergoing some major modifications. Translations are a very WIP feature, and do not currently save. Please be patient. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Roadmap</a>.</p>
                            <fieldset class="_formBlock" style="padding-bottom: 1rem; border: 1px solid var(--accent-tertiary);">
                                <legend class="caption">Icon Set</legend>
                                <div>
                                    <label style="border-color: var(--background-highlight);">
                                        <input type="radio" checked="">
                                        <span class="label">Default</span>
                                    </label>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </section>
            <section id="theme" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Theme Settings</h1>
                            <div class="_formBlock" style="background-color: var(--background-secondary) !important; border-radius: 8px !important;">
                                <div style="position: relative; padding: 27px 0; text-align: center;">
                                    <div style="display: inline-block; text-align: left; padding: 0 100px; vertical-align: bottom;">
                                        <div class="demo-theme-container">
                                            <svg width="28px" height="28px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                                <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                                <g id="SVGRepo_iconCarrier">
                                                    <path d="M3.32031 11.6835C3.32031 16.6541 7.34975 20.6835 12.3203 20.6835C16.1075 20.6835 19.3483 18.3443 20.6768 15.032C19.6402 15.4486 18.5059 15.6834 17.3203 15.6834C12.3497 15.6834 8.32031 11.654 8.32031 6.68342C8.32031 5.50338 8.55165 4.36259 8.96453 3.32996C5.65605 4.66028 3.32031 7.89912 3.32031 11.6835Z" stroke="#3498db" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </g>
                                            </svg>
                                            <label class="toggle-theme" onclick="toggleTheme()">
                                                <div class="slider"></div>
                                            </label>
                                            <svg width="28px" height="28px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                                <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                                <g id="SVGRepo_iconCarrier">
                                                    <path d="M12 3V4M12 20V21M4 12H3M6.31412 6.31412L5.5 5.5M17.6859 6.31412L18.5 5.5M6.31412 17.69L5.5 18.5001M17.6859 17.69L18.5 18.5001M21 12H20M16 12C16 14.2091 14.2091 16 12 16C9.79086 16 8 14.2091 8 12C8 9.79086 9.79086 8 12 8C14.2091 8 16 9.79086 16 12Z" stroke="#fff001" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </g>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                                <div class="label">
                                    <div class="caption" style="padding: 2px 12px;">Themes are synced across clients by default. They are very Work In Progress. Custom themes may not sync correctly. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap.html" target="_blank" rel="noopener noreferrer">Roadmap</a></div>
                                </div>
                            </div>
                            <div>
                                <div class="settings_title_display">
                                    <label for="theme-select">Appearance:</label>
                                    <select id="theme-select">
                                        <option value="dark" selected>Dark</option>
                                        <option value="light">Light</option>
                                        <option value="custom">Custom</option>
                                    </select>
                                </div>
                                <hr>
                                <div class="settings_subsection">
                                    <h3>Theme Overrides <sup style="font-size: 9px; color: red; text-decoration: underline;">BETA</sup></h3>
                                    <div style="gap: 8px; display: flex; margin: 18px 0px 8px; display: none;"></div>
                                    <!-- Note: These each require their own background-color override; making them globals would require vodoo magic beyond my understanding -->
                                    <div class="theme_overrides">
                                        <div class="theme_override" style="background-color: var(--background-primary);">
                                            <span class="theme_title">primary background</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-bg-color" value="#04050a">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--background-secondary);">
                                            <span class="theme_title">secondary background</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-bg-secondary" value="#12121d">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--background-tertiary);">
                                            <span class="theme_title" style="color: var(--text-primary);">tertiary background</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-bg-tertiary" value="#202023">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--background-highlight);">
                                            <span class="theme_title" style="color: var(--text-primary);">background highlight</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-bg-highlight" value="#30303f">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--accent-primary);">
                                            <span class="theme_title" style="color: var(--text-primary);">Accent Color</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-accent-color" value="#6c76ce">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--accent-secondary);">
                                            <span class="theme_title">Secondary Accent</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-accent-secondary" value="#8086d4">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--accent-tertiary);">
                                            <span class="theme_title">tertiary accent</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-accent-tertiary" value="#5667c7">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--accent-highlight);">
                                            <span class="theme_title" style="color: var(--bg-color);">accent highlight</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-accent-highlight" value="#9397da">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--text-primary);">
                                            <span class="theme_title" style="color: var(--background-tertiary);">Primary Text</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-text-color" value="#ffffff">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--text-secondary);">
                                            <span class="theme_title" style="color: var(--background-tertiary);">Secondary Text</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-text-secondary" value="#d7d9e0">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="theme_override" style="background-color: var(--text-tertiary);">
                                            <span class="theme_title">Terciary Text</span>
                                            <div class="theme_picker_container">
                                                <div class="theme_picker">
                                                    <input class="theme_input" type="color" id="custom-text-tertiary" value="#12121f">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="action_buttons">
                                        <button class="button" id="apply-custom">Apply Custom</button>
                                        <button class="button" onclick="exportTheme()">Export Theme</button>
                                    </div>
                                    <!-- 
                                        <label for="theme-import" style="cursor: pointer;">Import Theme</label>
                                        <input type="file" id="theme-import" accept="application/json" style="display: none;" onchange="importTheme(this.files[0])"/>
                                     -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section id="plugins" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Plugins</h1>
                            <p class="caption">Plugins are currently in <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Beta</a>.</p>
                            <form>
                                <select name="" id="" class="select" style="border-color: rgb(35, 35, 47); padding-left: 37px; padding-right: 37px;"></select>
                            </form>
                            <form>
                                <div class="disclaimer" role="note">
                                    <p class="caption">Third-party plugins run with access to your account and are provided as-is, without warranty. We are not responsible for any data loss, security issues, or damage caused by plugins you choose to install. Install at your own risk.</p>
                                </div>
                                <p>Upload a plugin</p>
                                <input type="file" id="plugin-import">
                            </form>
                        </div>
                    </div>
                </div>
            </section>
            <section id="mutes-blocks" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Mutes and Blocks</h1>
                            <p>This feature doesn't exist. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Roadmap</a>.</p>
                        </div>
                    </div>
                </div>
            </section>
            <section id="api" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>API</h1>
                            <h3>Using API v<%- version %></h3>
                            <p class="caption">API Interactions are currently restricted.</p>
                            <label>
                                <input type="radio" checked="">
                                <span class="label">Auto Migrate API Versions</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>
            <section id="webhook" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Webhook</h1>
                            <p class="caption">Payload URL WIP. <a href="https://blog.hydraulisc.net/blog/haulisc-roadmap" target="_blank" rel="noopener noreferrer">Roadmap</a>.</p>
                        </div>
                    </div>
                </div>
            </section>
            <section id="developer" class="settings_section" >
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Developer</h1>
                            <h3>Register new OAuth App</h3>
                            <div class="disclaimer">
                                <p class="caption">
                                    By registering an OAuth application, you agree that:
                                    <ul class="caption">
                                        <li>You are responsible for your application and everything it does with user data and access.</li>
                                        <li>You will only request the permissions your application actually needs, and will use user data solely for the purpose users authorized.</li>
                                        <li>You will store client secrets and access tokens securely, and will not share, sell, or misuse them.</li>
                                        <li>Your application will not be used for spam, scraping, impersonation, malware, or any other abusive or illegal activity.</li>
                                        <li>You will clearly tell users what your application does and what data it accesses.</li>
                                        <li>We may revoke credentials, suspend, or remove your application at any time, without notice, if it violates these terms or puts users at risk.</li>
                                        <li>Your application is provided as-is. We are not responsible for any damages resulting from its use.</li>
                                        <li>You will comply with all applicable laws, including data protection laws such as the GDPR.</li>
                                        <li>You will respect API rate limits and will not attempt to circumvent them.</li>
                                    </ul>
                                </p>
                            </div>
                            <form method="POST" action="/oauth/developer">
                                <input type="text" name="app_name" placeholder="App Name" required="" class="formInput">
                                <input type="url" name="redirect_uri" placeholder="Redirect URI" required="" class="formInput">
                                <br>
                                <button type="submit">Register App</button>
                            </form>
                            <h3 class="label">Your OAuth Apps</h3>
                            <% if (apps.length === 0) { %>
                                <p>You haven't created any OAuth apps yet.</p>
                            <% } else { %>
                                <div class="users_table_container">
                                    <table class="users_table">
                                        <thead>
                                            <tr>
                                                <th>Client Name</th>
                                                <th>Client ID</th>
                                                <th>Secret</th>
                                                <th>Redirect</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        <% apps.forEach(app => { %>
                                            <tr>
                                                <td><%= app.name %></td>
                                                <td><%= app.id %></td>
                                                <td><%= app.secret %></td>
                                                <td><%= app.redirect_uri %></td>
                                            </tr>
                                        <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </section>
            <section id="other" class="settings_section">
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Other</h1>
                            <h3>Additional Settings will appear here.</h3>
                            <label style="border-color: rgba(255, 89, 117, 0.15);">
                                <input type="radio"  checked>
                                <span class="label">BTRT</span>
                            </label>
                            <label style="border-color: rgba(255, 89, 117, 0.15);">
                                <input type="radio">
                                <span class="label">DRYs</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>
            <% if (isAdmin == true) { %>
            <section id="admin-users" class="settings_section">
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Administrator Settings</h1>
                            <% if(inviteMode) { %>
                            <label style="border-color: rgba(255, 89, 117, 0.15);">
                                <span class="label">Generate Invites</span>
                                <form action="/auth/admin/generate-invite" method="POST">
                                    <input type="number" name="count" placeholder="Number of Invites" value="3" required />
                                    <button type="submit">Generate</button>
                                </form>
                            </label>
                            <% } %>
                            <h3 style="display: none;" class="mobileRevealMe">Administate Users</h3>
                            <fieldset class="mobileHideMe" style="border: 1px solid var(--accent-tertiary); padding: 8px">
                                <legend class="caption">Administate Users</legend>
                                <div class="users_table_container">
                                    <table class="users_table">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>Role</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% users.forEach(function(user) { %>
                                                <tr>
                                                    <td>
                                                        <a href="/user/<%= user.id %>" target="_blank">@<%= user.username %>#<%= user.discriminator %></a>
                                                    </td>
                                                    <td>
                                                        <% if (user.id !== ownId) { %>
                                                            <form action="/dashboard/users/toggle-admin" method="POST" class="inline-form">
                                                                <input type="hidden" name="userId" value="<%= user.id %>">
                                                                <button type="submit" class="admin_toggle <%= user.isAdmin ? 'active' : '' %>">
                                                                    <%= user.isAdmin ? 'Admin' : 'User' %>
                                                                </button>
                                                            </form>
                                                        <% } else { %>
                                                            <button class="admin_toggle">
                                                                Admin (You)
                                                            </button>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <div class="action_buttons">
                                                            <a href="/user/<%= user.id %>" class="view_button">View</a>
                                                            <% if (user.id !== ownId) { %>
                                                                <form action="/dashboard/users/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this user?')">
                                                                    <input type="hidden" name="userId" value="<%= user.id %>">
                                                                    <button type="submit" class="delete_button">Delete</button>
                                                                </form>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                            <section style="display: none;" class="mobileRevealMe" id="usersDisplayCards">
                                <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
                                    <% users.forEach(function(user) { %>
                                        <div style="box-sizing: border-box; width: 100%; padding: 16px; background-color: var(--background-secondary); border: 1px solid var(--background-highlight); border-radius: 12px;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                                                <a href="/user/<%= user.id %>" style="font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    @<%= user.username %>#<%= user.discriminator %><%= user.id === ownId ? ' (You)' : '' %>
                                                </a>
                                                <span style="flex-shrink: 0; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--accent-primary); <%= user.isAdmin ? 'background: var(--accent-primary); color: #fff;' : 'color: var(--text-secondary);' %>">
                                                    <%= user.isAdmin ? 'Admin' : 'User' %>
                                                </span>
                                            </div>
                                            <% if (user.id !== ownId) { %>
                                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--background-highlight);">
                                                    <form action="/dashboard/users/toggle-admin" method="POST" style="margin: 0;">
                                                        <input type="hidden" name="userId" value="<%= user.id %>">
                                                        <button type="submit" style="margin: 0; <%= user.isAdmin ? 'background: transparent; border: 1px solid var(--accent-primary);' : '' %>"><%= user.isAdmin ? 'Demote' : 'Promote' %></button>
                                                    </form>
                                                    <form action="/dashboard/users/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this user?')">
                                                        <input type="hidden" name="userId" value="<%= user.id %>">
                                                        <button type="submit" style="margin: 0; background: transparent; border: 1px solid var(--accent-tertiary); color: var(--accent-highlight) !important;">Delete</button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% }) %>
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </section>
            <section id="admin-oauth" class="settings_section">
                <div class="settings_container">
                    <div class="settings_scroll">
                        <div class="settings_order">
                            <h1>Administrator Settings</h1>
                            <h3 style="display: none;" class="mobileRevealMe">OAuth Apps</h3>
                            <fieldset class="mobileHideMe" style="border: 1px solid var(--accent-tertiary); padding: 8px">
                                <legend class="caption">Administate OAuth Clients</legend>
                                <div class="users_table_container">
                                    <table class="users_table">
                                        <thead>
                                            <tr>
                                                <th>Nickname</th>
                                                <th>Redirect</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% oauths.forEach(function(client) { %>
                                                <tr>
                                                    <td>
                                                        <span><%= client.name %></span>
                                                    </td>
                                                    <td>
                                                        <a href="<%= client.redirect_uri %>" target="_blank">Redirect</a>
                                                    </td>
                                                    <td>
                                                        <div class="action_buttons">
                                                            <a href="<%= client.redirect_uri %>" class="view_button">View</a>
                                                            <form action="/dashboard/clients/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this client?')">
                                                                <input type="hidden" name="userId" value="<%= client.id %>">
                                                                <button type="submit" class="delete_button">Delete</button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                            <section style="display: none;" class="mobileRevealMe" id="oauthClientsCards">
                                <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
                                    <% oauths.forEach(function(client) { %>
                                        <div style="box-sizing: border-box; width: 100%; padding: 16px; background-color: var(--background-secondary); border: 1px solid var(--background-highlight); border-radius: 12px;">
                                            <div>
                                                <p><%= client.name %></p>
                                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--background-highlight);">
                                                    <p><a href="<%= client.redirect_uri %>" target="_blank">Redirect</a></p>
                                                    <p><a href="<%= client.redirect_uri %>" class="view_button">View</a></p>
                                                    <form action="/dashboard/clients/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this client?')">
                                                        <input type="hidden" name="userId" value="<%= client.id %>">
                                                        <button type="submit" style="margin: 0; background: transparent; border: 1px solid var(--accent-tertiary); color: var(--accent-highlight) !important;">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </section>
            <% } %>
        </main>
    </div>
    <script>
        const theUidToTargetNow = '<%- ownId %>';
    </script>
    <%- include('../partials/cookies', { cookies }) %>
    <%- include('../partials/footer', { username: ownId }) %>
</body>
</html>